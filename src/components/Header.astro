---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="site-shell nav">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<a href="https://github.com/W-David/astro-blog" target="_blank" rel="noopener noreferrer">GitHub</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
	}
	.nav {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.25rem;
		min-height: 3.25rem;
		padding: 0.7rem 0;
	}
	.brand {
		color: var(--text);
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		line-height: 1.35;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.15rem 0.85rem;
		flex: none;
	}
	.links :global(a) {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.92rem;
	}
	.links :global(a:hover),
	.links :global(a.active) {
		color: var(--text);
	}
	@media (max-width: 640px) {
		.nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.35rem;
		}
	}
</style>
