---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header" data-header>
	<a class="brand" href="/" aria-label={`${SITE_TITLE} — 首页`}>
		<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" fill="none">
			<circle cx="16" cy="16" r="12.5" stroke="currentColor" stroke-width="1"></circle>
			<circle cx="16" cy="16" r="4" fill="currentColor"></circle>
			<path d="M16 1.5v4M16 26.5v4M1.5 16h4M26.5 16h4" stroke="currentColor" stroke-width="1"></path>
		</svg>
		<span class="brand-copy">
			<strong>MR.WANG</strong>
			<small>RUSHING'S TRAVEL</small>
		</span>
	</a>

	<nav class="site-nav" aria-label="主导航">
		<HeaderLink href="/">Index</HeaderLink>
		<HeaderLink href="/blog">Notes</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
	</nav>

	<div class="header-right">
		<span class="clock" aria-label="上海时间"><span>SHA</span><time data-clock>--:--</time></span>
		<a
			class="github-link"
			href="https://github.com/W-David/astro-blog"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="在 GitHub 查看源码"
		>
			<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
				<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
			</svg>
		</a>
	</div>
</header>
