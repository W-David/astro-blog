---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, tags } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<main>
		<article class="site-shell article">
			<p class="back"><a href="/blog">文章</a></p>
			<header>
				<div class="meta">
					<span><FormattedDate date={pubDate} /></span>
					{category && <span>{category}</span>}
					{updatedDate && (
						<span>更新于 <FormattedDate date={updatedDate} /></span>
					)}
				</div>
				<h1>{title}</h1>
				{description && <p class="desc">{description}</p>}
				{(tags?.length ?? 0) > 0 && (
					<p class="tags">{tags.map((tag) => `#${tag}`).join('  ')}</p>
				)}
			</header>

			{heroImage && (
				<div class="cover">
					<Image width={1200} height={630} src={heroImage} alt="" />
				</div>
			)}

			<div class="prose">
				<slot />
			</div>
		</article>
	</main>
</BaseLayout>

<style>
	.article {
		padding: 2.25rem 0 1rem;
	}
	.back {
		margin: 0 0 1.25rem;
		font-size: 0.9rem;
	}
	.back a {
		color: var(--muted);
		text-decoration: none;
	}
	.back a:hover {
		color: var(--text);
		text-decoration: underline;
	}
	.meta,
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin: 0 0 0.6rem;
		color: var(--muted);
		font-size: 0.88rem;
	}
	.tags {
		display: block;
		margin-bottom: 0;
	}
	.desc {
		color: var(--muted);
		margin: 0.75rem 0 0;
	}
	.cover {
		margin: 1.5rem 0 0;
	}
	.cover :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
	}
	.prose {
		margin-top: 1.75rem;
		padding-top: 0.25rem;
	}
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin-top: 1.6em;
	}
	.prose :global(img) {
		display: block;
		margin: 1.1rem auto;
		border-radius: 4px;
	}
	.prose :global(a) {
		color: var(--text);
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.25rem;
	}
	.prose :global(li) {
		margin: 0.3rem 0;
	}
	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.2rem 0;
		font-size: 0.92rem;
	}
	.prose :global(th),
	.prose :global(td) {
		border-bottom: 1px solid var(--line);
		padding: 0.45rem 0.4rem;
		text-align: left;
		vertical-align: top;
	}
</style>
