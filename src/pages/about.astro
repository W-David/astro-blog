---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`关于 · ${SITE_TITLE}`} description="关于 Rushing's travel of Mr.Wang">
	<main class="site-shell about">
		<h1>关于</h1>
		<p>
			这里是 <strong>Rushing's travel of Mr.Wang</strong>。文章来自原先的 VuePress
			站点 RecoBlog，现为 Astro 静态博客。
		</p>
		<p>分类沿用原仓库目录：图库、杂记、算法、记录、运维。图库图片使用 GitHub raw 链接。</p>
		<p>
			源码：
			<a href="https://github.com/W-David/astro-blog" target="_blank" rel="noopener noreferrer">W-David/astro-blog</a>
			· 旧站：
			<a href="https://github.com/W-David/RecoBlog" target="_blank" rel="noopener noreferrer">W-David/RecoBlog</a>
		</p>
	</main>
</BaseLayout>

<style>
	.about {
		padding: 2.75rem 0 1rem;
	}
	.about a {
		color: var(--text);
	}
</style>
