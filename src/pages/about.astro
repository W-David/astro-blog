---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutImage from '../assets/images/post-desk.jpg';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`关于 · ${SITE_TITLE}`} description="关于 Rushing's travel of Mr.Wang">
	<main>
		<section class="about-hero shell">
			<div class="about-heading">
				<p class="kicker">About the author · 关于</p>
				<h1>藏在<br /><em>屏幕后面。</em></h1>
			</div>
			<figure class="about-photo" data-reveal>
				<Image
					src={aboutImage}
					alt="一张靠窗的书桌，笔记本屏幕亮着代码，旁边放着一杯咖啡"
					width={1400}
					height={933}
					quality={74}
					loading="eager"
				/>
				<figcaption><span>Workbench / 2026</span><span>Somewhere after midnight</span></figcaption>
			</figure>
		</section>

		<section class="about-content shell">
			<div class="about-copy" data-reveal>
				<p class="about-lede">我是 Mr.Wang，一个写代码的人，也偶尔写点字。</p>
				<p>白天和服务器、前端构建和无穷无尽的日志打交道；晚上关掉编辑器之后，会把白天没想明白的问题继续写下来。写得很慢，也常常推翻重来。</p>
				<p>这里最早是 VuePress 时代的 RecoBlog，现在搬到了 Astro。主题叫「Lumen」：它不试图把所有东西都塞到第一屏，而是留出一张图、一段空白，和足够慢的阅读速度。</p>				<p>如果你也在深夜调试过什么，或者只是路过，欢迎从任意一篇文章开始。</p>
			</div>

			<aside class="about-side" data-reveal>
				<dl class="about-facts">
					<div><dt>Name</dt><dd>Mr.Wang / coody</dd></div>
					<div><dt>Base</dt><dd>屏幕前 · 有时在路上</dd></div>
					<div><dt>Focus</dt><dd>Web / Infra / Notes</dd></div>
					<div><dt>Since</dt><dd>2019 — Now</dd></div>
				</dl>
				<p class="about-note">“Keep the light. 记录代码，也记录光。”</p>
				<div class="about-links">
					<a href="https://github.com/W-David" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
					<a href="https://github.com/W-David/RecoBlog" target="_blank" rel="noopener noreferrer">Old RecoBlog <span aria-hidden="true">↗</span></a>
					<a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
				</div>
			</aside>
		</section>

		<section class="about-close shell" data-reveal>
			<p class="kicker">Currently open</p>
			<p class="about-close__text">继续写，继续修，继续在凌晨四点确认一次构建。</p>
			<a class="about-cta" href="/blog">Browse the notes <span aria-hidden="true">↗</span></a>
		</section>
	</main>
</BaseLayout>

<style>
	.about-hero {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(40px, 8vw, 140px);
		align-items: end;
		padding-top: clamp(150px, 19vh, 220px);
	}

	.about-heading h1 {
		margin: 30px 0 0;
		font-size: clamp(4.2rem, 10vw, 10.6rem);
		font-weight: 300;
		line-height: 0.88;
		letter-spacing: -0.07em;
	}

	.about-heading h1 em {
		color: var(--warm);
		font-family: var(--serif);
		font-style: italic;
		font-weight: 400;
	}

	.about-photo {
		margin: 0;
	}

	.about-photo :global(img) {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		filter: brightness(0.78) saturate(0.8) contrast(1.03);
	}

	.about-photo figcaption {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		margin-top: 12px;
		padding-top: 10px;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-family: var(--mono);
		font-size: 8px;
		letter-spacing: 0.08em;
	}

	.about-content {
		display: grid;
		grid-template-columns: 1.25fr 0.75fr;
		gap: clamp(50px, 9vw, 160px);
		padding-top: clamp(110px, 14vw, 190px);
	}

	.about-copy p {
		max-width: 630px;
		color: rgba(243, 239, 230, 0.66);
		font-size: 16px;
		line-height: 2.1;
	}

	.about-copy .about-lede {
		margin-bottom: 36px;
		color: var(--paper);
		font-size: clamp(1.8rem, 3.2vw, 3.3rem);
		line-height: 1.45;
		letter-spacing: -0.035em;
	}

	.about-facts {
		margin: 0;
		border-top: 1px solid var(--line);
	}

	.about-facts div {
		display: flex;
		justify-content: space-between;
		gap: 24px;
		padding: 15px 0;
		border-bottom: 1px solid var(--line);
	}

	.about-facts dt {
		color: var(--muted);
		font-family: var(--mono);
		font-size: 9px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.about-facts dd {
		margin: 0;
		color: var(--paper);
		font-size: 12px;
		text-align: right;
	}

	.about-note {
		margin: 36px 0 0;
		color: var(--muted);
		font-family: var(--serif);
		font-size: 20px;
		font-style: italic;
		line-height: 1.6;
	}

	.about-links {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
		margin-top: 38px;
	}

	.about-links a {
		padding-bottom: 3px;
		border-bottom: 1px solid var(--line);
		color: var(--paper);
		font-size: 10px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.about-links a:hover {
		border-color: var(--warm);
		color: var(--warm);
	}

	.about-close {
		margin-top: clamp(120px, 15vw, 210px);
		padding-top: 24px;
		border-top: 1px solid var(--line);
	}

	.about-close__text {
		max-width: 1000px;
		margin: 24px 0 40px;
		color: var(--paper);
		font-size: clamp(2rem, 4.2vw, 4.6rem);
		line-height: 1.25;
		letter-spacing: -0.045em;
	}

	.about-cta {
		display: inline-block;
		padding-bottom: 5px;
		border-bottom: 1px solid var(--warm);
		color: var(--warm);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	@media (max-width: 900px) {
		.about-hero,
		.about-content {
			grid-template-columns: 1fr;
		}

		.about-photo {
			max-width: 560px;
		}

		.about-content {
			gap: 60px;
		}
	}

	@media (max-width: 680px) {
		.about-hero {
			padding-top: 132px;
		}

		.about-heading h1 {
			font-size: clamp(3.5rem, 16vw, 5.5rem);
		}

		.about-copy p {
			font-size: 15px;
		}

		.about-copy .about-lede {
			font-size: 1.8rem;
		}

		.about-close__text {
			font-size: 2rem;
		}
	}
</style>
