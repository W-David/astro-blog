---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<section class="hero site-shell">
			<div class="hero-panel glass reveal reveal-scale">
				<p class="eyebrow">Personal Blog · Astro</p>
				<h1>
					<span class="gradient-text">{SITE_TITLE}</span>
				</h1>
				<p class="lead">{SITE_DESCRIPTION}</p>
				<div class="hero-meta">
					<span class="badge">{posts.length} 篇文章</span>
					{categories.map((c) => <span class="badge">{c}</span>)}
				</div>
				<div class="hero-actions">
					<a class="btn primary" href="/blog">浏览文章</a>
					<a class="btn ghost" href="/about">关于本站</a>
				</div>
			</div>
			<div class="hero-side reveal reveal-right" data-delay="160">
				<div class="stat glass">
					<strong>{posts.length}</strong>
					<span>Posts</span>
				</div>
				<div class="stat glass">
					<strong>{categories.length}</strong>
					<span>Categories</span>
				</div>
				<div class="stat glass">
					<strong>∞</strong>
					<span>Scroll vibes</span>
				</div>
			</div>
		</section>

		<section class="site-shell posts">
			<div class="section-head reveal">
				<h2>最新文章</h2>
				<p>向下滚动，卡片会依次亮起</p>
			</div>
			<div class="grid">
				{posts.map((post, i) => <PostCard post={post} index={i} />)}
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	main { padding-bottom: 2rem; }
	.hero {
		display: grid;
		grid-template-columns: 1.5fr 0.8fr;
		gap: 1.25rem;
		padding: 3.5rem 0 2rem;
		align-items: stretch;
	}
	.hero-panel {
		padding: 2.2rem 2rem;
		border-radius: 28px;
		position: relative;
		overflow: hidden;
	}
	.hero-panel::after {
		content: "";
		position: absolute;
		inset: -40% auto auto 40%;
		width: 280px;
		height: 280px;
		background: radial-gradient(circle, rgba(167, 139, 250, 0.28), transparent 70%);
		pointer-events: none;
	}
	.eyebrow {
		margin: 0 0 0.85rem;
		color: var(--accent);
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
	}
	.lead {
		color: var(--text-muted);
		font-size: 1.05rem;
		max-width: 36rem;
		margin-bottom: 1.25rem;
	}
	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.7rem 1.15rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		border: 1px solid transparent;
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}
	.btn:hover {
		transform: translateY(-2px);
		text-shadow: none;
	}
	.btn.primary {
		color: #041018;
		background: linear-gradient(135deg, #7dd3fc, #a78bfa);
		box-shadow: 0 10px 30px rgba(125, 211, 252, 0.25);
	}
	.btn.ghost {
		color: #e8eefc;
		border-color: rgba(125, 211, 252, 0.3);
		background: rgba(255, 255, 255, 0.03);
	}
	.hero-side {
		display: grid;
		gap: 0.85rem;
	}
	.stat {
		border-radius: var(--radius);
		padding: 1.1rem 1.2rem;
		display: grid;
		gap: 0.2rem;
	}
	.stat strong {
		font-size: 1.8rem;
		background: linear-gradient(110deg, #7dd3fc, #a78bfa);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.stat span {
		color: var(--text-muted);
		font-size: 0.9rem;
	}
	.posts { padding: 1rem 0 3rem; }
	.section-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.section-head h2 { margin: 0; }
	.section-head p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	@media (max-width: 900px) {
		.hero { grid-template-columns: 1fr; }
		.hero-side { grid-template-columns: repeat(3, 1fr); }
	}
	@media (max-width: 700px) {
		.grid { grid-template-columns: 1fr; }
		.hero-side { grid-template-columns: 1fr; }
		.section-head { flex-direction: column; align-items: start; }
	}
</style>
