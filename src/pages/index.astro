---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categories = [...new Set(posts.map((post) => post.data.category).filter(Boolean))];
const latest = posts[0];
const years = posts.map((post) => post.data.pubDate.getUTCFullYear());
const yearRange = years.length ? `${Math.min(...years)}—${Math.max(...years)}` : '—';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-haze" aria-hidden="true"></div>

			<div class="hero-inner shell">
				<p class="kicker">Rushing's travel of Mr.Wang · Est. 2019</p>
				<h1 id="hero-title">Notes,<br /><em>after dark.</em></h1>
				<p class="hero-sub">关于代码、系统，<br />以及沿途看见的光。</p>
			</div>

			<div class="hero-bottom shell">
				<div class="hero-notes">
					<a class="scroll-cue" href="#archive">
						<span class="scroll-line" aria-hidden="true"></span>
						<span>Scroll to the archive</span>
					</a>
					<p class="hero-hint">移动鼠标 / 滚动页面 — 扰动这片点阵</p>
				</div>

				{latest && (
					<aside class="glass-note" aria-label="最新文章">
						<span class="glass-label">Latest note / 最新</span>
						<h2>{latest.data.title}</h2>
						<p class="glass-meta">
							<FormattedDate date={latest.data.pubDate} />
							{latest.data.category && <span> · {latest.data.category}</span>}
						</p>
						<a class="glass-link" href={`/blog/${latest.id}/`}>Read the note <span aria-hidden="true">↗</span></a>
					</aside>
				)}
			</div>
		</section>

		<section class="intro shell" aria-labelledby="intro-title" data-reveal>
			<p class="kicker kicker--accent">The personal archive</p>
			<div class="intro-grid">
				<h2 id="intro-title">写给深夜，<br />也写给<em>明天</em>。</h2>
				<div class="intro-copy">
					<p>这里存放一些没有 deadline 的文字：服务器故障后的复盘、某段代码的来龙去脉，以及坐在屏幕前等到天亮的那些时刻。</p>
					<p>技术是线索，生活是背景。每一次 debug、每一座路过的城市，都值得留一页。</p>
				</div>
				<dl class="stats">
					<div><dt>Notes</dt><dd>{String(posts.length).padStart(2, '0')}</dd></div>
					<div><dt>Categories</dt><dd>{String(categories.length).padStart(2, '0')}</dd></div>
					<div><dt>Years</dt><dd>{yearRange}</dd></div>
					<div><dt>Signal</dt><dd>∞</dd></div>
				</dl>
			</div>
		</section>

		<section class="archive shell" id="archive" aria-labelledby="archive-title">
			<div class="section-heading" data-reveal>
				<div>
					<p class="kicker">Selected notes / 2019—2022</p>
					<h2 id="archive-title">所有<em>笔记</em></h2>
				</div>
				<p class="section-heading__meta">{String(posts.length).padStart(2, '0')} STORIES<br />SCROLL SLOWLY</p>
			</div>

			<ol class="poster-grid">
				{posts.map((post, index) => <PostCard post={post} index={index} />)}
			</ol>
		</section>
	</main>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		overflow: hidden;
		padding: 0 0 42px;
	}

	.hero-haze {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(900px 620px at 69% 33%, rgba(255, 184, 140, 0.12), transparent 66%),
			radial-gradient(760px 560px at 18% 78%, rgba(138, 231, 255, 0.06), transparent 64%),
			linear-gradient(90deg, rgba(8, 9, 13, 0.62) 0%, rgba(8, 9, 13, 0.16) 48%, rgba(8, 9, 13, 0) 76%),
			linear-gradient(180deg, rgba(8, 9, 13, 0.32) 0%, transparent 28%, rgba(8, 9, 13, 0.74) 100%);
	}

	.hero-inner {
		position: relative;
		z-index: 2;
		margin-top: auto;
		padding-top: 180px;
	}

	.hero h1 {
		max-width: 1100px;
		margin: 26px 0 30px;
		font-size: clamp(4rem, 10.6vw, 10.6rem);
		font-weight: 300;
		line-height: 0.9;
		letter-spacing: -0.055em;
	}

	.hero h1 em {
		display: inline-block;
		margin-left: 7vw;
		color: transparent;
		font-family: var(--serif);
		font-style: italic;
		font-weight: 400;
		letter-spacing: -0.02em;
		background: linear-gradient(100deg, #ffb88c 4%, #e8ccff 50%, #8ae7ff 96%);
		-webkit-background-clip: text;
		background-clip: text;
	}

	.hero-sub {
		margin: 0;
		color: rgba(243, 239, 230, 0.78);
		font-size: clamp(13px, 1.05vw, 15px);
		letter-spacing: 0.05em;
		line-height: 2;
	}

	.hero-bottom {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
		margin-top: 70px;
	}

	.hero-notes {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.hero-hint {
		margin: 0;
		color: rgba(243, 239, 230, 0.34);
		font-size: 8px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.scroll-cue {
		display: inline-flex;
		align-items: center;
		gap: 16px;
		padding-bottom: 6px;
		color: rgba(243, 239, 230, 0.5);
		font-size: 9px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}

	.scroll-line {
		display: block;
		width: 62px;
		height: 1px;
		background: linear-gradient(90deg, var(--warm), transparent);
		transition: width 0.4s var(--ease);
	}

	.scroll-cue:hover .scroll-line {
		width: 92px;
	}

	.glass-note {
		width: 310px;
		padding: 21px 23px 23px;
		border: 1px solid rgba(243, 239, 230, 0.16);
		border-radius: 5px;
		background: linear-gradient(150deg, rgba(28, 30, 38, 0.6), rgba(12, 14, 19, 0.44));
		-webkit-backdrop-filter: blur(22px) saturate(1.3);
		backdrop-filter: blur(22px) saturate(1.3);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
	}

	.glass-label {
		color: var(--warm);
		font-size: 8.5px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}

	.glass-note h2 {
		margin: 11px 0 7px;
		font-size: 19px;
		font-weight: 300;
		letter-spacing: 0.01em;
		line-height: 1.45;
	}

	.glass-meta {
		margin: 0;
		color: var(--muted);
		font-size: 10.5px;
		letter-spacing: 0.04em;
		line-height: 1.8;
	}

	.glass-link {
		display: inline-flex;
		gap: 8px;
		margin-top: 15px;
		padding-bottom: 3px;
		border-bottom: 1px solid rgba(243, 239, 230, 0.3);
		color: rgba(243, 239, 230, 0.9);
		font-size: 10.5px;
		letter-spacing: 0.1em;
	}

	.glass-link:hover {
		border-color: var(--warm);
		color: var(--warm);
	}

	.intro {
		padding-top: clamp(100px, 14vw, 190px);
	}

	.intro-grid {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 50px clamp(40px, 9vw, 160px);
		align-items: start;
		margin-top: 30px;
	}

	.intro h2 {
		margin: 0;
		font-size: clamp(2.8rem, 5.2vw, 5.6rem);
		line-height: 1.08;
		letter-spacing: -0.06em;
	}

	.intro h2 em {
		color: var(--warm);
		font-family: var(--serif);
		font-style: italic;
		font-weight: 400;
	}

	.intro-copy {
		padding-top: 8px;
	}

	.intro-copy p {
		max-width: 520px;
		color: rgba(243, 239, 230, 0.66);
		font-size: 14px;
		line-height: 2.1;
	}

	.stats {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin: 34px 0 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.stats div {
		padding: 24px 4px 22px;
		border-right: 1px solid var(--line);
	}

	.stats div:last-child {
		border-right: 0;
	}

	.stats dt {
		color: var(--muted);
		font-size: 8.5px;
		letter-spacing: 0.17em;
		text-transform: uppercase;
	}

	.stats dd {
		margin: 5px 0 0;
		font-size: clamp(1.6rem, 2.7vw, 2.8rem);
		font-weight: 300;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.archive {
		padding-top: clamp(110px, 14vw, 190px);
	}

	.poster-grid {
		margin-top: clamp(38px, 6vw, 82px);
	}

	@media (max-width: 1000px) {
		.intro-grid {
			grid-template-columns: 1fr;
			gap: 26px;
		}

		.stats {
			grid-column: auto;
		}
	}

	@media (max-width: 680px) {
		.hero {
			min-height: 780px;
			padding-bottom: 24px;
		}

		.hero-inner {
			padding-top: 140px;
		}

		.hero h1 {
			margin: 22px 0 24px;
			font-size: clamp(3.3rem, 16vw, 5.4rem);
		}

		.hero h1 em {
			margin-left: 2vw;
		}

		.hero-bottom {
			display: block;
			margin-top: 44px;
		}

		.glass-note {
			width: 100%;
			margin-top: 34px;
		}

		.intro {
			padding-top: 88px;
		}

		.intro h2 {
			font-size: clamp(2.35rem, 11vw, 3.8rem);
		}

		.intro-copy p {
			font-size: 13px;
		}

		.stats {
			grid-template-columns: repeat(2, 1fr);
			margin-top: 24px;
		}

		.stats div:nth-child(2n) {
			border-right: 0;
		}

		.stats div:nth-child(n + 3) {
			border-top: 1px solid var(--line);
		}
	}
</style>
